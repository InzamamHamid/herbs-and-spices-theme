{%- liquid
  assign s = section.settings
  assign words = section.blocks | where: 'type', 'word'
  assign chips = section.blocks | where: 'type', 'chip'
  assign first = words.first
-%}
{%- comment -%}
  "Spice Dust" hero.
  The big spice word is real HTML first (fast first paint, works with JS off and
  with reduced motion). hsd-hero-dust.js then draws the same word as powder in a
  WebGL canvas on top, and cycles through the "Spice word" blocks.
  Every word is passed to the script through data-* attributes (no Liquid in JS).
{%- endcomment -%}
<section
  class="hsd hsd-hero"
  aria-labelledby="HsHeroTitle-{{ section.id }}"
  data-hsd-dust
  data-motion="{{ s.motion }}"
  data-interval="{{ s.interval | times: 1000 }}"
  {% if s.background_image != blank %}data-has-photo{% endif %}
>
  {%- if s.background_image != blank -%}
    <div class="hsd-hero__photo" aria-hidden="true">
      {{ s.background_image | image_url: width: 2000 | image_tag:
        widths: '750, 1100, 1500, 2000',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high',
        alt: ''
      }}
    </div>
  {%- endif -%}

  <div class="hsd-container hsd-hero__inner">
    <div class="hsd-hero__meta">
      {%- if s.location != blank -%}<span>{{ s.location | escape }}</span>{%- endif -%}
      {%- if s.proof != blank -%}<span class="hsd-hero__proof">{{ s.proof | escape }}</span>{%- endif -%}
    </div>

    {%- if first -%}
      <div class="hsd-hero__stage">
        <canvas class="hsd-hero__canvas" aria-hidden="true"></canvas>
        <a
          class="hsd-hero__word"
          href="{{ first.settings.link | default: routes.search_url }}"
          data-hsd-dust-link
          style="--hsd-word-color: {{ first.settings.color }}"
        ><span data-hsd-dust-word>{{ first.settings.word | escape }}</span></a>

        <ul class="hsd-hero__words" hidden>
          {%- for block in words -%}
            <li
              data-word="{{ block.settings.word | escape }}"
              data-lang="{{ block.settings.language | escape }}"
              data-meaning="{{ block.settings.meaning | escape }}"
              data-color="{{ block.settings.color }}"
              data-link="{{ block.settings.link | default: routes.search_url }}"
              {{ block.shopify_attributes }}
            ></li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%}
        One row under the word: what it means, the product it points to, and the
        pause control. Each "Spice word" block can name a product; the card for the
        word on screen is shown and the rest stay hidden.
      {%- endcomment -%}
      <div class="hsd-hero__strip">
        <p class="hsd-hero__caption" data-hsd-dust-caption>
          <span data-hsd-dust-lang>{{ first.settings.language | escape }}</span>
          <span aria-hidden="true">·</span>
          <span data-hsd-dust-meaning>{{ first.settings.meaning | escape }}</span>
        </p>

        {%- for block in words -%}
          {%- assign p = block.settings.product -%}
          {%- if p != blank -%}
            {%- assign v = p.selected_or_first_available_variant -%}
            <div class="hsd-pick" data-hsd-pick="{{ forloop.index0 }}" data-hsd-spice="{{ block.settings.color }}" style="--hsd-spice: {{ block.settings.color }}" {% unless forloop.first %}hidden{% endunless %}>
              <a class="hsd-pick__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if p.featured_media -%}
                  {{ p.featured_media | image_url: width: 160 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}
                {%- endif -%}
              </a>
              <div class="hsd-pick__text">
                <a class="hsd-pick__title" href="{{ p.url }}">{{ p.title | escape }}</a>
                <span class="hsd-pick__price">{{ p.price | money }}{% if p.price_varies %}+{% endif %}</span>
              </div>
              {%- if p.available and p.has_only_default_variant -%}
                {%- form 'product', p, class: 'hsd-pick__form', data-hsd-quick-add: '' -%}
                  <input type="hidden" name="id" value="{{ v.id }}">
                  <button type="submit" class="hsd-btn hsd-btn--turmeric hsd-pick__add" aria-label="Add {{ p.title | escape }} to cart">
                    {% render 'hsd-icon', icon: 'plus', size: 16, stroke: 2.4 %}<span>Add</span>
                  </button>
                {%- endform -%}
              {%- else -%}
                <a class="hsd-btn hsd-btn--outline hsd-pick__add" href="{{ p.url }}">{% if p.available %}Choose{% else %}Details{% endif %}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}

        {%- if s.motion != 'off' and words.size > 0 -%}
          <button type="button" class="hsd-hero__pause" data-hsd-dust-pause aria-pressed="false" hidden>
            <span class="hsd-hero__pause-icon" aria-hidden="true"></span>
            <span data-hsd-dust-pause-label>Pause motion</span>
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hsd-hero__bottom">
      <div class="hsd-hero__copy">
        <h1 class="hsd-h1 hsd-hero__title" id="HsHeroTitle-{{ section.id }}">{{ s.heading | escape }}</h1>
        {%- if s.text != blank -%}<p class="hsd-lede">{{ s.text | escape }}</p>{%- endif -%}
      </div>

      <div class="hsd-hero__shop">
        {%- if s.show_search -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="hsd-search hsd-search--hero">
            {% render 'hsd-icon', icon: 'search', size: 20 %}
            <label for="HsHeroSearch-{{ section.id }}" class="hsd-visually-hidden">Search products</label>
            <input id="HsHeroSearch-{{ section.id }}" type="search" name="q" placeholder="{{ s.search_placeholder | escape }}" autocomplete="off">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="hsd-btn hsd-btn--turmeric">Search</button>
          </form>
          {%- if chips.size > 0 -%}
            <div class="hsd-chips hsd-chips--hero">
              <span class="hsd-small">Popular:</span>
              {%- for block in chips -%}
                <a class="hsd-chip" href="{{ block.settings.link | default: routes.search_url }}" {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</a>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endif -%}

        <div class="hsd-hero__actions">
          {%- if s.button_label != blank -%}
            <a href="{{ s.button_link | default: routes.all_products_collection_url }}" class="hsd-btn hsd-btn--primary">{{ s.button_label | escape }} {% render 'hsd-icon', icon: 'arrow', size: 18, stroke: 2.2 %}</a>
          {%- endif -%}
          {%- if s.video_label != blank -%}
            <a href="{{ s.video_link | default: '#hsd-story' }}" class="hsd-btn hsd-btn--outline">
              {% render 'hsd-icon', icon: 'play', size: 16 %}{{ s.video_label | escape }}
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- if s.motion != 'off' -%}
  <script type="module" src="{{ 'hsd-hero-dust.js' | asset_url }}"></script>
{%- endif -%}

{% schema %}
{
  "name": "HSD Hero",
  "class": "hsd-section-hero",
  "settings": [
    { "type": "text", "id": "location", "label": "Top line, left", "default": "Cordele, Georgia · Open 7 days" },
    { "type": "text", "id": "proof", "label": "Top line, right", "default": "547K views on Facebook" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Every kitchen's spices. One shop in Georgia." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Spices, rice, teas and wellness from our shop floor in Cordele. Picked, packed and shipped across the US the next business day." },
    { "type": "header", "content": "Spice dust" },
    {
      "type": "select", "id": "motion", "label": "Motion", "default": "full",
      "options": [
        { "value": "full", "label": "Spice dust + cursor" },
        { "value": "calm", "label": "Spice dust, no cursor" },
        { "value": "off", "label": "Off (words only)" }
      ],
      "info": "Visitors who ask their device for reduced motion always see the still version."
    },
    { "type": "range", "id": "interval", "label": "Seconds per word", "min": 3, "max": 10, "step": 1, "default": 5 },
    { "type": "image_picker", "id": "background_image", "label": "Shop photo behind the dust", "info": "Optional. Shown darkened. Wide, at least 2000 px." },
    { "type": "header", "content": "Search" },
    { "type": "checkbox", "id": "show_search", "label": "Show search bar", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Try \"black seed\", \"basmati\" or \"soursop\"" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Main button", "default": "Shop the shelves" },
    { "type": "url", "id": "button_link", "label": "Main button link" },
    { "type": "text", "id": "video_label", "label": "Video link label", "default": "Watch the video" },
    { "type": "url", "id": "video_link", "label": "Video link", "info": "Leave empty to jump to the story section on this page" }
  ],
  "blocks": [
    {
      "type": "word",
      "name": "Spice word",
      "settings": [
        { "type": "text", "id": "word", "label": "Word", "default": "Haldi", "info": "Keep it short: 12 letters or fewer reads best." },
        { "type": "text", "id": "language", "label": "Language", "default": "Hindi / Urdu" },
        { "type": "text", "id": "meaning", "label": "Meaning", "default": "Turmeric" },
        {
          "type": "select", "id": "color", "label": "Dust colour", "default": "#E0A21B",
          "options": [
            { "value": "#E0A21B", "label": "Turmeric" },
            { "value": "#D9412B", "label": "Chilli" },
            { "value": "#5E9C4F", "label": "Leaf" },
            { "value": "#B8753F", "label": "Cinnamon" },
            { "value": "#F3E9CF", "label": "Cream" }
          ]
        },
        { "type": "url", "id": "link", "label": "Link", "info": "Where the word goes when tapped, e.g. /search?q=turmeric" },
        { "type": "product", "id": "product", "label": "Product to show under the word", "info": "Optional. A small card with price and Add button appears while this word is on screen." }
      ]
    },
    {
      "type": "chip",
      "name": "Popular search",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Turmeric" },
        { "type": "url", "id": "link", "label": "Link", "info": "Collection or search link, e.g. /search?q=turmeric" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "HSD Hero",
      "blocks": [
        { "type": "word", "settings": { "word": "Haldi", "language": "Hindi / Urdu", "meaning": "Turmeric", "color": "#E0A21B" } },
        { "type": "word", "settings": { "word": "Scotch bonnet", "language": "Jamaica", "meaning": "Hot pepper", "color": "#D9412B" } },
        { "type": "word", "settings": { "word": "Kasuri methi", "language": "Punjabi", "meaning": "Dried fenugreek", "color": "#5E9C4F" } },
        { "type": "word", "settings": { "word": "Kalonji", "language": "Urdu / Bengali", "meaning": "Black seed", "color": "#F3E9CF" } },
        { "type": "word", "settings": { "word": "Canela", "language": "Spanish", "meaning": "Cinnamon", "color": "#B8753F" } },
        { "type": "chip", "settings": { "label": "Turmeric" } },
        { "type": "chip", "settings": { "label": "Basmati rice" } },
        { "type": "chip", "settings": { "label": "Soursop" } },
        { "type": "chip", "settings": { "label": "Black seed" } }
      ]
    }
  ]
}
{% endschema %}
