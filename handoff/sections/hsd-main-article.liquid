{%- comment -%}
  Recipe / article page with "Shop the ingredients".
  Ingredients come from the article metafield custom.products
  (type: list of product references) — pick them in the article admin.
{%- endcomment -%}
{%- assign products = article.metafields.custom.products.value -%}
<article class="hsd">
  <div class="hsd-container">
    <nav class="hsd-breadcrumb" aria-label="Breadcrumb" style="padding-bottom:0">
      <ol><li><a href="{{ routes.root_url }}">Home</a></li><li><a href="{{ blog.url }}">{{ blog.title | escape }}</a></li><li><span aria-current="page">{{ article.title | escape }}</span></li></ol>
    </nav>
    <header class="hsd-page-head" style="max-width:900px">
      <div class="hsd-meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %-d, %Y' }}</time>
        {%- if article.author != blank -%}<span>By {{ article.author | escape }}</span>{%- endif -%}
      </div>
      <h1 class="hsd-h1" style="font-size:clamp(34px,4.4vw,60px)">{{ article.title | escape }}</h1>
    </header>
    {%- if article.image -%}
      <div class="hsd-article-hero">{{ article.image | image_url: width: 1600 | image_tag: loading: 'eager', widths: '600, 900, 1200, 1600', sizes: '100vw', alt: article.image.alt | default: '' }}</div>
    {%- endif -%}

    <div class="{% if products.size > 0 %}hsd-content-grid{% endif %}" style="{% unless products.size > 0 %}padding-bottom:var(--hsd-section-y){% endunless %}">
      <div class="hsd-prose">
        {{ article.content }}
        {%- if article.tags.size > 0 -%}
          <div class="hsd-tags" style="margin-top:32px">{%- for tag in article.tags -%}<a class="hsd-chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag | escape }}</a>{%- endfor -%}</div>
        {%- endif -%}
      </div>
      {%- if products.size > 0 -%}
        <aside class="hsd-aside" aria-label="Shop the ingredients" style="background:var(--hsd-surface)">
          <p class="hsd-eyebrow">{{ section.settings.shop_heading | escape }}</p>
          <ul role="list" style="list-style:none;margin:0;padding:0;display:grid;gap:12px">
            {%- for p in products -%}
              <li style="display:grid;grid-template-columns:56px 1fr auto;gap:12px;align-items:center">
                <span style="width:56px;aspect-ratio:1;border-radius:10px;overflow:hidden;background:var(--hsd-cream);border:1px solid var(--hsd-line)">{%- if p.featured_media -%}{{ p.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '', style: 'width:100%;height:100%;object-fit:contain' }}{%- endif -%}</span>
                <a href="{{ p.url }}" style="color:var(--hsd-ink);font-weight:600;font-size:15px;line-height:1.3">{{ p.title | escape }}<br><span class="hsd-small">{{ p.price | money }}</span></a>
                {%- if p.available and p.has_only_default_variant -%}
                  {%- form 'product', p, data-hsd-quick-add: '' -%}
                    <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                    <button type="submit" class="hsd-icon-btn hsd-icon-btn--green" aria-label="Add {{ p.title | escape }} to cart">{% render 'hsd-icon', icon: 'plus', size: 18, stroke: 2.4 %}</button>
                  {%- endform -%}
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </aside>
      {%- endif -%}
    </div>
  </div>
</article>

{% schema %}
{
  "name": "HSD Article",
  "class": "hsd-section-article",
  "settings": [ { "type": "text", "id": "shop_heading", "label": "Shop the ingredients heading", "default": "Shop the ingredients" } ],
  "enabled_on": { "templates": ["article"] }
}
{% endschema %}
