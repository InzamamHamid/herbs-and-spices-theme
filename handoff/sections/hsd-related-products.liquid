{%- comment -%}
  "More on the same shelf" — Shopify Product Recommendations API.
  The first page load renders an empty shell; JS below fetches this same
  section with recommendations filled in. Scales to any catalogue size
  because Shopify computes the list server-side.
{%- endcomment -%}
<section class="hsd hsd-section" data-hsd-recs
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent={{ section.settings.intent }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="hsd-container">
      <div class="hsd-section-head">
        <div class="hsd-section-head__text">
          <p class="hsd-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 class="hsd-h2">{{ section.settings.heading | escape }}</h2>
        </div>
      </div>
      <ul class="hsd-grid" style="--hsd-cols: {{ section.settings.limit }}" role="list">
        {%- for rec in recommendations.products -%}
          <li>{% render 'hsd-product-card', product: rec %}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</section>

<script>
  (() => {
    const el = document.currentScript.previousElementSibling;
    if (!el || el.children.length) return;
    fetch(el.dataset.url)
      .then((r) => r.text())
      .then((html) => {
        const fresh = new DOMParser().parseFromString(html, 'text/html').querySelector('[data-hsd-recs]');
        if (fresh && fresh.innerHTML.trim()) el.innerHTML = fresh.innerHTML;
      })
      .catch(() => {});
  })();
</script>

{% schema %}
{
  "name": "HSD Product — related",
  "class": "hsd-section-related",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "On the same shelf" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also need" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "select", "id": "intent", "label": "Type", "default": "related", "options": [
      { "value": "related", "label": "Similar products" },
      { "value": "complementary", "label": "Goes well with (set in Search & Discovery app)" } ] }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
