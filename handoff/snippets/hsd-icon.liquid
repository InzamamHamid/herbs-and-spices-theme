{%- comment -%}
  Line icons (24px grid, stroke = currentColor).
  Usage: {% render 'hsd-icon', icon: 'truck', size: 24 %}
{%- endcomment -%}
{%- liquid
  assign size = size | default: 24
  assign stroke = stroke | default: 1.8
-%}
<svg class="hsd-icon hsd-icon--{{ icon }}" width="{{ size }}" height="{{ size }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ stroke }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case icon -%}
    {%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>
    {%- when 'account' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/>
    {%- when 'bag' -%}<path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
    {%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h10"/>
    {%- when 'close' -%}<path d="M6 6l12 12M18 6L6 18"/>
    {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
    {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
    {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
    {%- when 'check' -%}<path d="M5 12l5 5 9-10"/>
    {%- when 'pin' -%}<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/>
    {%- when 'box' -%}<path d="M3 7l9-4 9 4-9 4-9-4z"/><path d="M3 7v10l9 4 9-4V7"/><path d="M12 11v10"/>
    {%- when 'label' -%}<path d="M6 3h9l4 4v14H6z"/><path d="M9 11h7M9 15h7M9 7h3"/>
    {%- when 'truck' -%}<path d="M2 7h11v9H2z"/><path d="M13 10h4l4 3v3h-8"/><circle cx="6" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {%- when 'shop' -%}<path d="M3 10l2-6h14l2 6"/><path d="M4 10v10h16V10"/><path d="M3 10h18"/><path d="M10 20v-5h4v5"/>
    {%- when 'return' -%}<path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/>
    {%- when 'phone' -%}<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>
    {%- when 'eye' -%}<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
    {%- when 'zoom' -%}<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/>
    {%- when 'camera' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M8 5l1.5-2h5L16 5"/>
    {%- comment -%} Department icons {%- endcomment -%}
    {%- when 'mortar' -%}<path d="M4 11h16l-2 7a3 3 0 0 1-3 2H9a3 3 0 0 1-3-2l-2-7z"/><path d="M14 11l5-7"/>
    {%- when 'sack' -%}<path d="M7 8c0-2 2-3 5-3s5 1 5 3l2 10a3 3 0 0 1-3 3H8a3 3 0 0 1-3-3l2-10z"/><path d="M9 5l-1-2h8l-1 2"/><path d="M9 13h6"/>
    {%- when 'capsule' -%}<path d="M10.5 20.5l10-10a4.95 4.95 0 0 0-7-7l-10 10a4.95 4.95 0 0 0 7 7z"/><path d="M8.5 8.5l7 7"/>
    {%- when 'cup' -%}<path d="M4 9h13v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V9z"/><path d="M17 11h1.5a2.5 2.5 0 0 1 0 5H17"/><path d="M8 3c0 2 2 2 2 4M12 3c0 2 2 2 2 4"/>
    {%- when 'dropper' -%}<path d="M9 10h6v10a1 1 0 0 1-1 1h-4a1 1 0 0 1-1-1V10z"/><path d="M10 10V7h4v3"/><path d="M12 7V3"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 6-14 14-14 0 8-6 14-14 14z"/><path d="M5 19l8-8"/>
    {%- when 'jar' -%}<path d="M7 7h10v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V7z"/><path d="M6 4h12v3H6z"/><path d="M10 13h4"/>
    {%- when 'pantry' -%}<path d="M4 8l8-4 8 4v10l-8 4-8-4V8z"/><path d="M4 8l8 4 8-4"/><path d="M12 12v10"/>
    {%- when 'facebook' -%}<path d="M14 8h3V4h-3a4 4 0 0 0-4 4v2H8v4h2v8h4v-8h3l1-4h-4V8z" fill="currentColor" stroke="none"/>
    {%- when 'play' -%}<path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none"/>
  {%- endcase -%}
</svg>
